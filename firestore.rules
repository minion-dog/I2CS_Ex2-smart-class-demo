rules_version = '2';

// =====================================================================
//  SmartClass - Firestore security rules
// =====================================================================
// WHY rules and not a server: the free Firebase plan has no server code,
// so every check that matters (who may mark whom, is the QR code real,
// is "in class" honest) is enforced here, on Google's side, where a
// student cannot change it.
//
// Roles:
//   lecturer = has a document staff/{uid}   (created by hand, see README)
//   student  = signed in with Google, email verified, email in roster/
//
// Attendance with no server (decision): every 5 s the lecturer writes the
// current code to sessions/{s}/codes/{token} with the SERVER's time.
// Students can NEVER read that collection; a student's attendance is
// accepted only if its token exists there AND is at most 12 s old (the
// current code + the one before it + network time). Physical only.
//
// Class photo (decision 25 Nov 2026): after scanning, each student taps
// their own face. claims/{version_box} can be created once, so two students
// can never take the same face.

service cloud.firestore {
  match /databases/{db}/documents {

    // ------------------------------------------------------------ helpers
    function signedIn() {
      return request.auth != null;
    }
    function isLecturer() {
      return signedIn() && exists(/databases/$(db)/documents/staff/$(request.auth.uid));
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isStudent() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(db)/documents/roster/$(myEmail()));
    }
    function quizOpen(s, q, index) {
      let z = get(/databases/$(db)/documents/sessions/$(s)/quizzes/$(q)).data;
      return z.state.phase == 'question' && z.state.index == index
        && request.time < z.state.startedAt + duration.value(z.questions[index].seconds + 2, 's');
    }
    function onlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }
    // A link must be empty or http(s) (no "javascript:" links), at most 20 files.
    function validSubmission() {
      return request.resource.data.repoUrl is string
        && request.resource.data.repoUrl.matches('^(https?://.+)?$')
        && request.resource.data.files is list
        && request.resource.data.files.size() <= 20;
    }

    // ------------------------------------------------------- staff/roster
    // The built-in AI key (Gemini). Set once by the course admin in the Firebase
    // console; only the lecturer's account can read it, nobody can write it from the app.
    match /config/{doc} {
      allow read: if isLecturer();
      allow write: if false;
    }

    match /staff/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;                       // created by hand in the console
    }
    // Student IDs live here, so only the lecturer reads it. exists() in the
    // helpers above works even without read access.
    // The weekly lecture times (lectures open by themselves): lecturer only.
    match /config/schedule {
      allow read, write: if isLecturer();
    }
    match /roster/{email} {
      allow read, write: if isLecturer();
    }
    // A student's profile (name, email) so the lecturer can show names.
    match /users/{uid} {
      allow read: if isLecturer() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == myEmail()
        && onlyKeys(['email', 'name', 'lastSeen']);
    }

    // ------------------------------------------------------------ sessions
    match /sessions/{s} {
      allow read: if isLecturer() || isStudent();
      allow create, update: if isLecturer();
      allow delete: if false;

      // The secret QR codes: write-only for the lecturer, invisible to students.
      match /codes/{token} {
        allow read: if isLecturer();
        allow create: if isLecturer() && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // The class photo with a box on every face (one document, < 1 MB).
      match /photo/{doc} {
        allow read: if isLecturer() || isStudent();
        allow write: if isLecturer();
      }

      // Who took which face: id = "<photo version>_<box id>", created once.
      // Students see only WHICH boxes are taken (the uid, never a name).
      match /claims/{claim} {
        allow read: if isLecturer() || isStudent();
        allow create: if isStudent()
          && onlyKeys(['uid', 'v'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.v == get(/databases/$(db)/documents/sessions/$(s)/photo/main).data.v
          // written together with my own attendance, which names this same box
          && claim == string(getAfter(/databases/$(db)/documents/sessions/$(s)/attendance/$(myEmail())).data.photoV)
                      + '_' + string(getAfter(/databases/$(db)/documents/sessions/$(s)/attendance/$(myEmail())).data.face);
        // the lecturer gives a box to a student (an accepted box request)
        allow create: if isLecturer() && onlyKeys(['uid', 'v']);
        allow update: if false;
        allow delete: if isLecturer();
      }

      // "There is no box on me": the student asks for a box where he tapped (one open
      // request at a time). The lecturer's page checks it with Gemini, or the lecturer decides.
      match /requests/{email} {
        allow read: if isLecturer() || (isStudent() && email == myEmail());
        allow create, update: if isStudent()
          && email == myEmail()
          && exists(/databases/$(db)/documents/sessions/$(s)/attendance/$(myEmail()))
          && onlyKeys(['email', 'uid', 'name', 'v', 'box', 'status', 'reason', 'faceId', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.faceId == 0
          && request.resource.data.v == get(/databases/$(db)/documents/sessions/$(s)/photo/main).data.v
          && (resource == null || resource.data.status != 'pending' || resource.data.v != request.resource.data.v);
        allow update, delete: if isLecturer();
      }


      // One attendance document per student per lecture, id = the email.
      match /attendance/{email} {
        allow read: if isLecturer() || (isStudent() && email == myEmail());

        // A student marks ONLY themselves, ONCE (create, never update).
        // Decision: attendance is physical only. Only someone in the room can film
        // the flicker QR live, so a real QR token of THIS session = in class.
        // No location.
        allow create: if isStudent()
          && email == myEmail()
          && onlyKeys(['email', 'uid', 'name', 'status', 'token', 'scannedAt'])
          && request.resource.data.email == myEmail()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.token is string
          && request.resource.data.status == 'present'
          && request.time < get(/databases/$(db)/documents/sessions/$(s)/codes/$(request.resource.data.token)).data.createdAt
                            + duration.value(12, 's');

        // After scanning, the student chooses their face once per photo (or says
        // "not in the photo" = -2, and may still choose later). A real box needs
        // the matching claim in the same write.
        allow update: if isStudent()
          && email == myEmail()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['face', 'photoV'])
          && request.resource.data.photoV == get(/databases/$(db)/documents/sessions/$(s)/photo/main).data.v
          && (resource.data.get('photoV', 0) != request.resource.data.photoV || resource.data.get('face', 0) == -2)
          && request.resource.data.face is int
          && (request.resource.data.face == -2
              || (request.resource.data.face > 0
                  && getAfter(/databases/$(db)/documents/sessions/$(s)/claims/$(string(request.resource.data.photoV) + '_' + string(request.resource.data.face))).data.uid == request.auth.uid));

        // The lecturer can mark by hand, fix or remove a record.
        allow create, update, delete: if isLecturer();
      }

      // Live quiz (Kahoot style). The answer key is in secret/ (lecturer only) and is
      // revealed one question at a time through the quiz's state.
      match /quizzes/{q} {
        allow read: if isLecturer() || isStudent();
        allow create, update: if isLecturer();
        allow delete: if false;
        match /secret/{doc} {
          allow read, write: if isLecturer();
        }
        // One answer per student per question, only while that question is open, timed
        // with the server's clock (question time + 2 s for the network).
        match /answers/{a} {
          allow read: if isLecturer() || (isStudent() && resource.data.uid == request.auth.uid);
          allow create: if isStudent()
            && onlyKeys(['uid', 'name', 'index', 'option', 'at'])
            && request.resource.data.uid == request.auth.uid
            && a == request.auth.uid + '_' + string(request.resource.data.index)
            && request.resource.data.at == request.time
            && request.resource.data.option is int
            && request.resource.data.option >= 0 && request.resource.data.option < 4
            && quizOpen(s, q, request.resource.data.index);
          allow update, delete: if false;
        }
      }

      // Comments: public ones are visible to all students; private ones only
      // to the lecturer and the author. An anonymous comment stores no name.
      match /comments/{c} {
        allow read: if isLecturer()
          || (isStudent() && (resource.data.visibility == 'public'
                              || resource.data.authorUid == request.auth.uid));
        allow create: if (isStudent() || isLecturer())
          && onlyKeys(['text', 'visibility', 'authorUid', 'authorName', 'createdAt', 'fromLecturer'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.visibility in ['public', 'private']
          && request.resource.data.fromLecturer == isLecturer();
        allow delete: if isLecturer();
        allow update: if false;
      }

      // Polls: the lecturer creates and closes them; one vote per student.
      match /polls/{p} {
        allow read: if isLecturer() || isStudent();
        allow create, update: if isLecturer();
        match /votes/{uid} {
          allow read: if isLecturer() || (signedIn() && request.auth.uid == uid);
          allow create: if isStudent()
            && request.auth.uid == uid
            && get(/databases/$(db)/documents/sessions/$(s)/polls/$(p)).data.open == true
            && onlyKeys(['option', 'votedAt'])
            && request.resource.data.option is int
            && request.resource.data.option >= 0
            && request.resource.data.option < get(/databases/$(db)/documents/sessions/$(s)/polls/$(p)).data.options.size();
          allow update, delete: if false;
        }
      }

      // Transcript pieces and the summary are written by the lecturer only.
      match /transcript/{piece} {
        allow read: if isLecturer() || isStudent();
        allow write: if isLecturer();
      }
    }

    // ---------------------------------------------------------- assignments
    match /assignments/{a} {
      allow read: if isLecturer() || isStudent();
      allow write: if isLecturer();

      match /submissions/{email} {
        allow read: if isLecturer() || (isStudent() && email == myEmail());
        // A student writes only their own submission and cannot touch the
        // review, grade or feedback fields.
        allow create: if isStudent()
          && email == myEmail()
          && onlyKeys(['email', 'name', 'repoUrl', 'files', 'submittedAt'])
          && request.resource.data.email == myEmail()
          && validSubmission();
        allow update: if isStudent()
          && email == myEmail()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'repoUrl', 'files', 'submittedAt'])
          && validSubmission();
        allow update: if isLecturer();
      }
    }
  }
}
